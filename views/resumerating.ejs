<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resume Intelligence | CareerAI</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f8fafc;
            color: #111827;
        }


        /* ================= NAVBAR ================= */

        .navbar {
            height: 75px;
            display: flex;
            align-items: center;
            padding: 0 5%;
            background: rgba(255,255,255,0.95);
            border-bottom: 1px solid #e5e7eb;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            font-size: 23px;
            font-weight: 800;
            margin-right: auto;
        }

        .logo-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 35px;
            height: 35px;
            margin-right: 7px;
            border-radius: 10px;
            color: white;
            background: linear-gradient(135deg,#4f46e5,#9333ea);
        }

        .logo span:last-child {
            color: #6366f1;
        }

        .nav-links {
            display: flex;
            gap: 30px;
        }

        .nav-links a {
            color: #4b5563;
            text-decoration: none;
            font-weight: 600;
            transition: 0.2s;
        }

        .nav-links a:hover {
            color: #4f46e5;
        }

        .nav-user {
            margin-left: 30px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 600;
        }

        .avatar {
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            color: white;
            background: linear-gradient(135deg,#6366f1,#8b5cf6);
        }


        /* ================= HERO ================= */

        .hero {
            text-align: center;
            padding: 80px 20px 45px;
        }

        .hero h1 {
            font-size: 48px;
            margin-bottom: 18px;
            background: linear-gradient(90deg,#4f46e5,#9333ea);
            -webkit-background-clip: text;
            color: transparent;
        }

        .hero p {
            max-width: 700px;
            margin: auto;
            color: #64748b;
            font-size: 18px;
            line-height: 1.7;
        }


        /* ================= SLIDER ================= */

        .slider-container {
            width: 100%;
            overflow: hidden;
            padding: 30px 0 80px;
        }

        .slider {
            display: flex;
            width: 200%;
            transition: transform 0.7s ease-in-out;
        }

        .slide {
            width: 50%;
            padding: 0 7%;
        }

        .slide-card {
            min-height: 520px;
            border-radius: 30px;
            padding: 55px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 50px;

            background: white;
            border: 1px solid #e5e7eb;
            box-shadow: 0 20px 60px rgba(15,23,42,0.08);
        }


        /* ================= SLIDE CONTENT ================= */

        .slide-content {
            flex: 1;
        }

        .slide-number {
            display: inline-block;
            padding: 8px 15px;
            border-radius: 20px;
            background: #eef2ff;
            color: #4f46e5;
            font-weight: 700;
            font-size: 13px;
            margin-bottom: 20px;
        }

        .slide-content h2 {
            font-size: 40px;
            margin-bottom: 18px;
        }

        .slide-content > p {
            color: #64748b;
            line-height: 1.7;
            font-size: 17px;
            margin-bottom: 28px;
        }

        .points {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 35px;
        }

        .point {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #374151;
            font-weight: 600;
        }

        .check {
            width: 25px;
            height: 25px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #eef2ff;
            color: #4f46e5;
            font-size: 13px;
        }


        /* ================= SLIDE VISUAL ================= */

        .slide-visual {
            width: 400px;
            height: 350px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .rating-box {
            width: 310px;
            padding: 30px;
            border-radius: 25px;
            background: #f8fafc;
            box-shadow: 0 15px 40px rgba(0,0,0,0.08);
            text-align: center;
        }

        .score-circle {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            margin: auto auto 20px;

            display: flex;
            align-items: center;
            justify-content: center;

            background:
                conic-gradient(#6366f1 78%,
                #e5e7eb 78%);

            position: relative;
        }

        .score-circle::after {
            content: "";
            position: absolute;
            width: 115px;
            height: 115px;
            background: white;
            border-radius: 50%;
        }

        .score {
            position: relative;
            z-index: 2;
            font-size: 32px;
            font-weight: 800;
        }

        .rating-box h3 {
            margin-bottom: 15px;
        }

        .rating-line {
            display: flex;
            justify-content: space-between;
            margin: 12px 0;
            font-size: 14px;
        }


        /* ================= MODIFY VISUAL ================= */

        .modify-box {
            width: 320px;
            padding: 30px;
            border-radius: 25px;
            background: #f8fafc;
            box-shadow: 0 15px 40px rgba(0,0,0,0.08);
        }

        .resume-document {
            background: white;
            padding: 22px;
            border-radius: 10px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        }

        .document-line {
            height: 8px;
            background: #e5e7eb;
            border-radius: 10px;
            margin-bottom: 12px;
        }

        .document-line.big {
            width: 65%;
            height: 12px;
        }

        .document-line.medium {
            width: 85%;
        }

        .document-line.small {
            width: 50%;
        }

        .arrow {
            text-align: center;
            font-size: 30px;
            margin: 12px 0;
            color: #6366f1;
        }


        /* ================= BUTTONS ================= */

        .button-row {
            display: flex;
            gap: 15px;
        }

        .btn {
            border: none;
            padding: 13px 23px;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: 0.2s;
        }

        .primary {
            color: white;
            background: linear-gradient(135deg,#4f46e5,#9333ea);
        }

        .secondary {
            background: #eef2ff;
            color: #4f46e5;
        }

        .btn:hover {
            transform: translateY(-2px);
        }


        /* ================= DOTS ================= */

        .dots {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-top: 25px;
        }

        .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #cbd5e1;
            cursor: pointer;
            transition: 0.3s;
        }

        .dot.active {
            width: 30px;
            border-radius: 10px;
            background: #6366f1;
        }


        /* ================= ABOUT ================= */

        .about {
            padding: 100px 8%;
            background: white;
            text-align: center;
        }

        .section-title {
            font-size: 38px;
            margin-bottom: 18px;
        }

        .section-description {
            max-width: 700px;
            margin: auto;
            color: #64748b;
            line-height: 1.7;
            font-size: 17px;
        }


        /* ================= FEATURES ================= */

        .features {
            padding: 80px 8%;
            background: #f8fafc;
        }

        .features h2 {
            text-align: center;
            font-size: 38px;
            margin-bottom: 50px;
        }

        .feature-grid {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 25px;
        }

        .feature-card {
            background: white;
            padding: 35px;
            border-radius: 20px;
            border: 1px solid #e5e7eb;
            transition: 0.3s;
        }

        .feature-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.08);
        }

        .feature-icon {
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            background: #eef2ff;
            color: #4f46e5;
            font-size: 23px;
            margin-bottom: 20px;
        }

        .feature-card h3 {
            margin-bottom: 12px;
        }

        .feature-card p {
            color: #64748b;
            line-height: 1.6;
        }


        /* ================= HOW IT WORKS ================= */

        .how {
            padding: 100px 8%;
            background: white;
        }

        .how h2 {
            text-align: center;
            font-size: 38px;
            margin-bottom: 50px;
        }

        .steps {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 25px;
        }

        .step {
            text-align: center;
        }

        .step-number {
            width: 55px;
            height: 55px;
            border-radius: 50%;
            margin: auto auto 20px;

            display: flex;
            align-items: center;
            justify-content: center;

            background: #eef2ff;
            color: #4f46e5;
            font-weight: 800;
            font-size: 20px;
        }

        .step p {
            color: #64748b;
            line-height: 1.6;
            margin-top: 10px;
        }


        /* ================= CTA ================= */

        .cta {
            padding: 100px 20px;
            text-align: center;
            background: linear-gradient(135deg,#4f46e5,#9333ea);
            color: white;
        }

        .cta h2 {
            font-size: 42px;
            margin-bottom: 18px;
        }

        .cta p {
            opacity: 0.9;
            margin-bottom: 30px;
            font-size: 17px;
        }

        .cta-button {
            display: inline-block;
            padding: 15px 30px;
            background: white;
            color: #4f46e5;
            border-radius: 10px;
            text-decoration: none;
            font-weight: 800;
        }


        /* ================= RESPONSIVE ================= */

        @media(max-width:900px) {

            .slide-card {
                flex-direction: column;
                padding: 35px;
            }

            .slide-visual {
                width: 100%;
            }

            .feature-grid {
                grid-template-columns: 1fr;
            }

            .steps {
                grid-template-columns: 1fr 1fr;
            }
        }

        @media(max-width:600px) {

            .nav-links {
                display: none;
            }

            .nav-user {
                margin-left: 10px;
            }

            .hero h1 {
                font-size: 36px;
            }

            .slide-content h2 {
                font-size: 30px;
            }

            .points {
                grid-template-columns: 1fr;
            }

            .steps {
                grid-template-columns: 1fr;
            }

            .button-row {
                flex-wrap: wrap;
            }
        }

    </style>
</head>


<body>


<!-- ================= NAVBAR ================= -->

<nav class="navbar">

    <div class="logo">
        <span class="logo-icon">C</span>
        Career<span>AI</span>
    </div>

    <div class="nav-links">
        <a href="/dashboard">Home</a>
        <a href="/resume-rating">Resume Intelligence</a>
