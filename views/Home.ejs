<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>CareerAI</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f8fafc;
            color: #111827;
        }

        /* NAVBAR */

        .navbar {
            height: 75px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 70px;
            background: white;
            border-bottom: 1px solid #e5e7eb;
        }

        .logo {
            font-size: 25px;
            font-weight: 800;
            color: #4f46e5;
        }

        .nav-buttons {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .login-btn,
        .signup-btn {
            padding: 11px 22px;
            border-radius: 10px;
            text-decoration: none;
            font-weight: 700;
            font-size: 14px;
        }

        .login-btn {
            color: #4f46e5;
            border: 1px solid #6366f1;
            background: white;
        }

        .signup-btn {
            color: white;
            background: linear-gradient(
                135deg,
                #4f46e5,
                #7c3aed
            );
        }

        .login-btn:hover {
            background: #eef2ff;
        }

        .signup-btn:hover {
            opacity: 0.9;
        }


        /* HERO */

        .hero {
            min-height: calc(100vh - 75px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 60px 30px;
            text-align: center;
        }

        .hero-content {
            max-width: 850px;
        }

        .badge {
            display: inline-block;
            padding: 8px 15px;
            border-radius: 30px;
            background: #eef2ff;
            color: #4f46e5;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 25px;
        }

        .hero h1 {
            font-size: 62px;
            line-height: 1.1;
            margin-bottom: 22px;
        }

        .hero h1 span {
            color: #4f46e5;
        }

        .hero p {
            max-width: 650px;
            margin: auto;
            color: #6b7280;
            font-size: 18px;
            line-height: 1.7;
        }

        .hero-buttons {
            margin-top: 35px;
            display: flex;
            justify-content: center;
            gap: 15px;
        }

        .get-started {
            padding: 15px 28px;
            border-radius: 12px;
            background: linear-gradient(
                135deg,
                #4f46e5,
                #7c3aed
            );
            color: white;
            text-decoration: none;
            font-weight: 700;
        }

        .learn-more {
            padding: 15px 28px;
            border-radius: 12px;
            background: white;
            color: #374151;
            border: 1px solid #d1d5db;
            text-decoration: none;
            font-weight: 700;
        }

        .get-started:hover {
            opacity: 0.9;
        }

        .learn-more:hover {
            background: #f9fafb;
        }


        /* FEATURES */

        .features {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 55px;
            flex-wrap: wrap;
        }

        .feature {
            width: 220px;
            padding: 22px;
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 16px;
            text-align: left;
        }

        .feature-icon {
            font-size: 25px;
            margin-bottom: 12px;
        }

        .feature h3 {
            font-size: 16px;
            margin-bottom: 7px;
        }

        .feature p {
            font-size: 13px;
            line-height: 1.5;
            color: #6b7280;
        }


        /* MOBILE */

        @media(max-width: 700px) {

            .navbar {
                padding: 0 20px;
            }

            .hero h1 {
                font-size: 42px;
            }

            .hero p {
                font-size: 16px;
            }

            .hero-buttons {
                flex-direction: column;
            }

            .get-started,
            .learn-more {
                width: 100%;
            }

        }

    </style>

</head>


<body>


    <!-- NAVBAR -->

    <nav class="navbar">

        <div class="logo">
            CareerAI
        </div>

        <div class="nav-buttons">

            <a href="/login"
               class="login-btn">

                Login

            </a>

            <a href="/signup"
               class="signup-btn">

                Sign Up

            </a>

        </div>

    </nav>



    <!-- HERO -->

    <section class="hero">

        <div class="hero-content">


            <div class="badge">

                🚀 Build Your Career Smarter

            </div>


            <h1>

                Your Career.

                <span>
                    Your Future.
                </span>

            </h1>


            <p>

                CareerAI helps you improve your resume,
                discover relevant job opportunities and
                build a stronger career profile — all in
                one place.

            </p>


            <div class="hero-buttons">

                <a href="/register"
                   class="get-started">

                    Get Started →

                </a>

                <a href="/login"
                   class="learn-more">

                    I Already Have an Account

                </a>

            </div>



            <!-- FEATURES -->

            <div class="features">


                <div class="feature">

                    <div class="feature-icon">
                        📄
                    </div>

                    <h3>
                        Resume Intelligence
                    </h3>

                    <p>
                        Analyze and improve your
                        resume for better opportunities.
                    </p>

                </div>



                <div class="feature">

                    <div class="feature-icon">
                        💼
                    </div>

                    <h3>
                        Job Discovery
                    </h3>

                    <p>
                        Find jobs that match your
                        skills and career goals.
                    </p>

                </div>



                <div class="feature">

                    <div class="feature-icon">
                        🎯
                    </div>

                    <h3>
                        Career Profile
                    </h3>

                    <p>
                        Build a professional profile
                        tailored to your career.
                    </p>

                </div>


            </div>


        </div>

    </section>


</body>

</html>