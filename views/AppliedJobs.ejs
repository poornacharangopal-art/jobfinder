<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Applied Jobs - CareerAI</title>


    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        body {
            font-family: Arial, sans-serif;

            background: #f8fafc;

            color: #111827;
        }


        .profile-layout {
            display: flex;

            min-height:
                calc(100vh - 75px);
        }


        .profile-content {
            flex: 1;

            padding: 50px;

            max-width: 1050px;
        }


        .page-header {
            margin-bottom: 30px;
        }


        .small-title {
            color: #6366f1;

            font-size: 12px;

            letter-spacing: 2px;

            font-weight: 800;

            margin-bottom: 10px;
        }


        .page-header h1 {
            font-size: 36px;

            margin-bottom: 10px;
        }


        .page-header p {
            color: #6b7280;
        }


        .empty-card {
            background: white;

            padding: 80px 30px;

            text-align: center;

            border: 1px solid #e5e7eb;

            border-radius: 22px;
        }


        .empty-icon {
            font-size: 60px;

            margin-bottom: 20px;
        }


        .empty-card h2 {
            margin-bottom: 10px;
        }


        .empty-card p {
            color: #6b7280;

            margin-bottom: 25px;
        }


        .primary-btn {
            display: inline-block;

            padding: 13px 22px;

            border-radius: 12px;

            text-decoration: none;

            color: white;

            font-weight: 700;

            background:
                linear-gradient(
                    135deg,
                    #4f46e5,
                    #7c3aed
                );
        }

    </style>

</head>


<body>


    <%- include("partials/navbar") %>


    <div class="profile-layout">


        <%- include("partials/profileSidebar") %>


        <main class="profile-content">


            <div class="page-header">

                <p class="small-title">
                    CAREER
                </p>

                <h1>
                    Applied Jobs
                </h1>

                <p>
                    Track the jobs you have applied for.
                </p>

            </div>



            <div class="empty-card">


                <div class="empty-icon">
                    💼
                </div>


                <h2>
                    No Applications Yet
                </h2>


                <p>
                    Jobs that you apply for will appear here.
                </p>


                <a href="/jobs"
                   class="primary-btn">

                    Find Jobs

                </a>


            </div>


        </main>


    </div>


</body>

</html>