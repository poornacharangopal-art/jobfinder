                Use your improved profile to explore relevant jobs.
            </p>

        </div>

    </div>

</section>



<!-- ================= CTA ================= -->

<section class="cta">

    <h2>
        Build a Better Career Profile
    </h2>

    <p>
        Start improving your resume and discover your next opportunity.
    </p>

    <a href="/dashboard" class="cta-button">
        Go to Dashboard →
    </a>

</section>



<!-- ================= JAVASCRIPT ================= -->

<script>

    let currentSlide = 0;

    const slider = document.getElementById("slider");
    const dots = document.querySelectorAll(".dot");


    function updateSlider() {

        if(currentSlide === 0) {

            slider.style.transform = "translateX(0%)";

        }
        else {

            slider.style.transform = "translateX(-50%)";

        }


        dots.forEach((dot,index) => {

            if(index === currentSlide) {

                dot.classList.add("active");

            }
            else {

                dot.classList.remove("active");

            }

        });

    }


    function nextSlide() {

        if(currentSlide < 1) {

            currentSlide++;

            updateSlider();

        }

    }


    function previousSlide() {

        if(currentSlide > 0) {

            currentSlide--;

            updateSlider();

        }

    }


    function goToSlide(index) {

        currentSlide = index;

        updateSlider();

    }

</script>


</body>
</html>