<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Profile - CareerAI</title>


    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        body {
            font-family: Arial, sans-serif;

            background: #f8fafc;

            color: #111827;
        }


        .profile-layout {
            display: flex;

            min-height:
                calc(100vh - 75px);
        }


        .profile-content {
            flex: 1;

            padding: 50px;

            max-width: 1100px;
        }


        .page-header {
            margin-bottom: 30px;
        }


        .small-title {
            color: #6366f1;

            font-size: 12px;

            letter-spacing: 2px;

            font-weight: 800;

            margin-bottom: 10px;
        }


        .page-header h1 {
            font-size: 36px;

            margin-bottom: 10px;
        }


        .page-header p {
            color: #6b7280;

            line-height: 1.6;
        }


        .profile-card {
            background: white;

            border: 1px solid #e5e7eb;

            border-radius: 22px;

            padding: 35px;

            box-shadow:
                0 10px 30px
                rgba(15,23,42,0.04);
        }


        .profile-card-header {
            display: flex;

            align-items: center;

            gap: 20px;

            padding-bottom: 30px;

            border-bottom:
                1px solid #e5e7eb;
        }


        .large-avatar {
            width: 75px;

            height: 75px;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 50%;

            background:
                linear-gradient(
                    135deg,
                    #4f46e5,
                    #9333ea
                );

            color: white;

            font-size: 30px;

            font-weight: 800;
        }


        .profile-card-header p {
            color: #6b7280;

            margin-bottom: 8px;
        }


        .student-badge {
            display: inline-block;

            padding: 5px 10px;

            border-radius: 20px;

            background: #eef2ff;

            color: #4f46e5;

            font-size: 12px;

            font-weight: 700;
        }


        .info-section {
            padding-top: 30px;
        }


        .info-section h3 {
            margin-bottom: 20px;
        }


        .info-grid {
            display: grid;

            grid-template-columns:
                repeat(2, 1fr);

            gap: 18px;
        }


        .info-box {
            padding: 18px;

            background: #f8fafc;

            border-radius: 13px;
        }


        .info-box span {
            display: block;

            color: #9ca3af;

            font-size: 12px;

            margin-bottom: 7px;
        }


        .info-box strong {
            font-size: 15px;
        }


        .profile-action {
            margin-top: 30px;
        }


        .primary-btn {
            display: inline-block;

            padding: 13px 22px;

            border-radius: 12px;

            text-decoration: none;

            color: white;

            font-weight: 700;

            background:
                linear-gradient(
                    135deg,
                    #4f46e5,
                    #7c3aed
                );
        }


        @media(max-width: 800px) {

            .profile-content {
                padding: 25px;
            }

            .info-grid {
                grid-template-columns: 1fr;
            }

        }

    </style>

</head>


<body>


    <%- include("partials/navbar") %>


    <div class="profile-layout">


        <%- include("partials/profileSidebar") %>


        <main class="profile-content">


            <div class="page-header">

                <p class="small-title">
                    MY PROFILE
                </p>

                <h1>
                    Welcome, <%= user.Name %> 👋
                </h1>

                <p>
                    Manage your personal information
                    and career profile.
                </p>

            </div>



            <div class="profile-card">


                <div class="profile-card-header">


                    <div class="large-avatar">

                        <%= user.Name
                            .charAt(0)
                            .toUpperCase() %>

                    </div>


                    <div>

                        <h2>
                            <%= user.Name %>
                        </h2>

                        <p>
                            <%= user.Gmail %>
                        </p>

                        <span class="student-badge">
                            Student
                        </span>

                    </div>


                </div>



                <div class="info-section">


                    <h3>
                        Account Information
                    </h3>


                    <div class="info-grid">


                        <div class="info-box">

                            <span>
                                Full Name
                            </span>

                            <strong>
                                <%= user.Name %>
                            </strong>

                        </div>



                        <div class="info-box">

                            <span>
                                Email
                            </span>

                            <strong>
                                <%= user.Gmail %>
                            </strong>

                        </div>


                    </div>


                </div>



                <div class="profile-action">

                    <a href="/profile/about"
                       class="primary-btn">

                        Complete Profile

                    </a>

                </div>


            </div>


        </main>


    </div>


</body>

</html>