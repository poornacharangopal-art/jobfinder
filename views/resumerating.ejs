    </p>

</section>



<!-- ================= HORIZONTAL SLIDER ================= -->

<section class="slider-container">

    <div class="slider" id="slider">


        <!-- ================= SLIDE 1 ================= -->

        <div class="slide">

            <div class="slide-card">

                <div class="slide-content">

                    <span class="slide-number">
                        01 / 02
                    </span>

                    <h2>Resume Rating</h2>

                    <p>
                        Get a detailed AI-powered analysis of your resume.
                        Understand how strong your resume is and what you
                        should improve before applying for jobs.
                    </p>

                    <div class="points">

                        <div class="point">
                            <span class="check">✓</span>
                            ATS Compatibility
                        </div>

                        <div class="point">
                            <span class="check">✓</span>
                            Skills Analysis
                        </div>

                        <div class="point">
                            <span class="check">✓</span>
                            Experience Analysis
                        </div>

                        <div class="point">
                            <span class="check">✓</span>
                            Project Analysis
                        </div>

                        <div class="point">
                            <span class="check">✓</span>
                            Missing Keywords
                        </div>

                        <div class="point">
                            <span class="check">✓</span>
                            Improvement Suggestions
                        </div>

                    </div>

                    <div class="button-row">

                        <button class="btn primary" onclick="nextSlide()">
                            Next →
                        </button>

                    </div>

                </div>


                <div class="slide-visual">

                    <div class="rating-box">

                        <div class="score-circle">

                            <span class="score">
                                78
                            </span>

                        </div>

                        <h3>Resume Score</h3>

                        <div class="rating-line">
                            <span>ATS Score</span>
                            <strong>72%</strong>
                        </div>

                        <div class="rating-line">
                            <span>Skills</span>
                            <strong>85%</strong>
                        </div>

                        <div class="rating-line">
                            <span>Projects</span>
                            <strong>88%</strong>
                        </div>

                    </div>

                </div>

            </div>

        </div>



        <!-- ================= SLIDE 2 ================= -->

        <div class="slide">

            <div class="slide-card">

                <div class="slide-content">

                    <span class="slide-number">
                        02 / 02
                    </span>

                    <h2>Modify Your Resume</h2>

                    <p>
                        Let CareerAI improve your existing resume while
                        keeping your original information intact.
                        Make your resume more professional and ATS-friendly.
                    </p>

                    <div class="points">

                        <div class="point">
                            <span class="check">✓</span>
                            Improve Grammar
                        </div>

                        <div class="point">
                            <span class="check">✓</span>
                            Professional Wording
                        </div>

                        <div class="point">
                            <span class="check">✓</span>
                            Better Summary
                        </div>

                        <div class="point">
                            <span class="check">✓</span>
                            Improve Projects
                        </div>

                        <div class="point">
                            <span class="check">✓</span>
                            ATS Optimization
                        </div>

                        <div class="point">
                            <span class="check">✓</span>
                            No Fake Information
                        </div>

                    </div>

                    <div class="button-row">

                        <button
                            class="btn secondary"
                            onclick="previousSlide()">
                            ← Previous
                        </button>

                        <a
                            href="/resumemodifier"
                            class="btn primary"
                            style="text-decoration:none;">
                            Modify Resume with AI
                        </a>

                    </div>

                </div>


                <div class="slide-visual">

                    <div class="modify-box">

                        <div class="resume-document">

                            <div class="document-line big"></div>
                            <div class="document-line small"></div>
                            <br>

                            <div class="document-line medium"></div>
                            <div class="document-line medium"></div>
                            <div class="document-line small"></div>

                            <div class="arrow">
                                ↓
                            </div>

                            <div class="document-line big"></div>
                            <div class="document-line medium"></div>
                            <div class="document-line medium"></div>
                            <div class="document-line small"></div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- DOTS -->

    <div class="dots">

        <span
            class="dot active"
            onclick="goToSlide(0)">
        </span>

        <span
            class="dot"
            onclick="goToSlide(1)">
        </span>

    </div>

</section>



<!-- ================= ABOUT CAREERAI ================= -->

