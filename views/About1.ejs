<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>About - CareerAI</title>


    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        body {
            font-family: Arial, sans-serif;

            background: #f8fafc;

            color: #111827;
        }


        .profile-layout {
            display: flex;

            min-height:
                calc(100vh - 75px);
        }


        .profile-content {
            flex: 1;

            padding: 50px;

            max-width: 1050px;
        }


        .page-header {
            margin-bottom: 30px;
        }


        .small-title {
            color: #6366f1;

            font-size: 12px;

            letter-spacing: 2px;

            font-weight: 800;

            margin-bottom: 10px;
        }


        .page-header h1 {
            font-size: 36px;

            margin-bottom: 10px;
        }


        .page-header p {
            color: #6b7280;
        }


        .about-card {
            background: white;

            padding: 35px;

            border-radius: 22px;

            border: 1px solid #e5e7eb;

            box-shadow:
                0 10px 30px
                rgba(15,23,42,0.04);
        }


        .about-header {
            display: flex;

            align-items: center;

            gap: 20px;

            padding-bottom: 30px;

            border-bottom:
                1px solid #e5e7eb;
        }


        .large-avatar {
            width: 75px;

            height: 75px;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 50%;

            background:
                linear-gradient(
                    135deg,
                    #4f46e5,
                    #9333ea
                );

            color: white;

            font-size: 30px;

            font-weight: 800;
        }


        .about-header p {
            color: #6b7280;

            margin-top: 5px;
        }


        .about-grid {
            display: grid;

            grid-template-columns:
                repeat(2, 1fr);

            gap: 18px;

            margin-top: 30px;
        }


        .about-item {
            padding: 18px;

            background: #f8fafc;

            border-radius: 13px;
        }


        .about-item span {
            display: block;

            color: #9ca3af;

            font-size: 12px;

            margin-bottom: 7px;
        }


        .about-item strong {
            font-size: 15px;
        }


        .skills-section {
            margin-top: 30px;
        }


        .skills-section h3 {
            margin-bottom: 15px;
        }


        .skills-container {
            display: flex;

            flex-wrap: wrap;

            gap: 10px;
        }


        .skill-tag {
            padding: 8px 13px;

            background: #eef2ff;

            color: #4f46e5;

            border-radius: 20px;

            font-size: 13px;

            font-weight: 600;
        }


        .profile-action {
            margin-top: 30px;
        }


        .primary-btn {
            display: inline-block;

            padding: 13px 22px;

            border-radius: 12px;

            text-decoration: none;

            color: white;

            font-weight: 700;

            background:
                linear-gradient(
                    135deg,
                    #4f46e5,
                    #7c3aed
                );
        }


        @media(max-width: 800px) {

            .profile-content {
                padding: 25px;
            }

            .about-grid {
                grid-template-columns: 1fr;
            }

        }

    </style>

</head>


<body>


    <%- include("partials/navbar") %>


    <div class="profile-layout">


        <%- include("partials/profileSidebar") %>


        <main class="profile-content">


            <div class="page-header">

                <p class="small-title">
                    ABOUT YOU
                </p>

                <h1>
                    Your Career Profile
                </h1>

                <p>
                    Your professional information at a glance.
                </p>

            </div>



            <div class="about-card">


                <div class="about-header">


                    <div class="large-avatar">

                        <%= user.Name
                            .charAt(0)
                            .toUpperCase() %>

                    </div>


                    <div>

                        <h2>
                            <%= user.Name %>
                        </h2>

                        <p>
                            Career Profile
                        </p>

                    </div>


                </div>



                <div class="about-grid">


                    <div class="about-item">

                        <span>
                            Name
                        </span>

                        <strong>
                            <%= user.Name %>
                        </strong>

                    </div>


                    <div class="about-item">

                        <span>
                            College
                        </span>

                        <strong>
                            <%= user.College || "Not added" %>
                        </strong>

                    </div>


                    <div class="about-item">

                        <span>
                            Passout Year
                        </span>

                        <strong>
                            <%= user.PassoutYear || "Not added" %>
                        </strong>

                    </div>


                    <div class="about-item">

                        <span>
                            Location
                        </span>

                        <strong>
                            <%= user.Location %>
                        </strong>

                    </div>


                </div>



                <div class="skills-section">

    <h3>
        Skills
    </h3>

    <div class="skills-container">

        <% if (user.Skills && user.Skills.length > 0) { %>

            <% user.Skills.forEach(function(skill) { %>

                <span class="skill-tag">
                    <%= skill %>
                </span>

            <% }) %>

        <% } else { %>

            <span>
                No skills added
            </span>

        <% } %>

    </div>

</div>


                <div class="profile-action">

                    <a
                        href="/profile/about/update"
                        class="primary-btn">

                        Update Profile

                    </a>

                </div>


            </div>


        </main>


    </div>


</body>

</html>